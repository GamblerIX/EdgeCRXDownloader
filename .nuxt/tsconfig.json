{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "~/*": ["../*"],
      "@/*": ["../*"],
      "#imports": ["./imports"],
      "vue": ["./stubs/vue"],
      "@tauri-apps/api/core": ["./stubs/tauri-core"],
      "@tauri-apps/plugin-dialog": ["./stubs/tauri-dialog"]
    }
  },
  "include": [
    "../app.vue",
    "../pages/**/*.vue",
    "../utils/**/*.ts",
    "../nuxt.config.ts",
    "../*.d.ts",
    "./imports.d.ts",
    "./fallback.d.ts",
    "./stubs/**/*.d.ts"
  ]
}